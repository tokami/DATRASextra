<!-- ``` -->



<!-- ## *Formatting* -->

<!-- From list(CA = , HH = , HL = ) to formatted dataframe. -->

<!-- ```{r, fig.alt = "", eval = FALSE} -->
<!-- surv_formatted <- formatFishglob(surv_weight)  ## TODO write function (in R/fishglob.R) -->
<!-- ``` -->

